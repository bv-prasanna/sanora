generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  DIRECTOR
  CORPORATE_OPS
  BRANCH_MANAGER
  BRANCH_PARTNER
  SALES
  SITE_ENGINEER
  PROCUREMENT
  FINANCE
  CUSTOMER
  AUDITOR
}

enum ProjectStatus {
  ENQUIRY
  ESTIMATION
  AWAITING_APPROVAL
  PLANNING
  IN_PROGRESS
  ON_HOLD
  HANDOVER
  COMPLETED
  CANCELLED
}

enum EstimateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SUPERSEDED
  REJECTED
}

enum LedgerType {
  TOP_UP
  MATERIAL_EXPENSE
  LABOUR_EXPENSE
  OTHER_EXPENSE
  REFUND
  REVERSAL
}

enum LedgerStatus {
  PENDING
  APPROVED
  POSTED
  REJECTED
  REVERSED
}

enum CommitmentStatus {
  OPEN
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

model User {
  id           String          @id @default(uuid())
  name         String
  phone        String?
  email        String          @unique
  passwordHash String
  role         UserRole        @default(CUSTOMER)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdProjects Project[]    @relation("ProjectCreator")
  customerProjects Project[]   @relation("ProjectCustomer")
  memberships  ProjectMember[]
  auditLogs    AuditLog[]
  ledgerEntries LedgerEntry[]  @relation("LedgerActor")
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreator")
  approvedPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderApprover")
  recordedLabour LabourRecord[] @relation("LabourRecorder")
  authoredProjectUpdates ProjectUpdate[] @relation("ProjectUpdateAuthor")
  uploadedProjectDocuments ProjectDocument[] @relation("ProjectDocumentUploader")
  submittedTopUps TopUpRequest[] @relation("TopUpRequester")
  reviewedTopUps TopUpRequest[] @relation("TopUpReviewer")
  assignedTasks ProjectTask[] @relation("ProjectTaskAssignee")
  createdTasks ProjectTask[] @relation("ProjectTaskCreator")
  notifications Notification[] @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationActor")
  assignedLeads Lead[] @relation("LeadAssignee")
  receivedInvitations CustomerInvitation[] @relation("InvitationUser")
  sentInvitations CustomerInvitation[] @relation("InvitationInviter")
}

model Project {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  location    String?
  description String?
  status      ProjectStatus   @default(ENQUIRY)
  customerId  String
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  customer    User            @relation("ProjectCustomer", fields: [customerId], references: [id])
  createdBy   User            @relation("ProjectCreator", fields: [createdById], references: [id])
  members     ProjectMember[]
  estimates   Estimate[]
  ledger      LedgerEntry[]
  commitments Commitment[]
  purchaseOrders PurchaseOrder[]
  labourRecords LabourRecord[]
  updates ProjectUpdate[]
  documents ProjectDocument[]
  topUpRequests TopUpRequest[]
  milestones ProjectMilestone[]
  tasks ProjectTask[]
  notifications Notification[]
  @@index([customerId, status])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  access    String   @default("VIEW")
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([projectId, userId])
}

model Estimate {
  id          String         @id @default(uuid())
  projectId   String
  version     Int
  status      EstimateStatus @default(DRAFT)
  title       String
  assumptions String?
  exclusions  String?
  validUntil  DateTime?
  createdById String
  createdAt   DateTime       @default(now())
  approvedAt  DateTime?
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines       EstimateLine[]
  @@unique([projectId, version])
  @@index([projectId, status])
}

model EstimateLine {
  id          String   @id @default(uuid())
  estimateId  String
  category    String
  description String
  specification String?
  quantity    Decimal  @db.Decimal(14, 3)
  unit        String
  unitRate    Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
}

model LedgerEntry {
  id             String       @id @default(uuid())
  projectId      String
  type           LedgerType
  status         LedgerStatus @default(PENDING)
  amount         Decimal      @db.Decimal(14, 2)
  description    String
  reference      String?
  vendorOrWorker String?
  quantity       Decimal?     @db.Decimal(14, 3)
  unit           String?
  unitRate       Decimal?     @db.Decimal(14, 2)
  invoiceNumber  String?
  evidenceUrl    String?
  idempotencyKey String       @unique
  createdById    String
  approvedById   String?
  createdAt      DateTime     @default(now())
  approvedAt     DateTime?
  postedAt       DateTime?
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("LedgerActor", fields: [createdById], references: [id])
  topUpRequest TopUpRequest?
  @@index([projectId, status, type])
}

model Commitment {
  id          String           @id @default(uuid())
  projectId   String
  description String
  vendor      String?
  amount      Decimal          @db.Decimal(14, 2)
  fulfilledAmount Decimal      @default(0) @db.Decimal(14, 2)
  status      CommitmentStatus @default(OPEN)
  reference   String?
  createdAt   DateTime         @default(now())
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, status])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])
  @@index([entityType, entityId, createdAt])
}

model CustomerProjectRelation {
  id String @id @default(uuid())
  // Reserved for future customer-specific relationship metadata.
}

 
enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum LabourRecordStatus {
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

model Vendor {
  id          String   @id @default(uuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  gstin       String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchaseOrders PurchaseOrder[]
  @@index([name, active])
}

model PurchaseOrder {
  id            String             @id @default(uuid())
  projectId     String
  vendorId      String
  orderNumber   String             @unique
  status        PurchaseOrderStatus @default(DRAFT)
  notes         String?
  subtotal      Decimal            @db.Decimal(14, 2)
  createdById   String
  approvedById  String?
  createdAt     DateTime           @default(now())
  approvedAt    DateTime?
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor        Vendor             @relation(fields: [vendorId], references: [id])
  createdBy     User               @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  approvedBy    User?              @relation("PurchaseOrderApprover", fields: [approvedById], references: [id])
  lines         PurchaseOrderLine[]
  receipts      MaterialReceipt[]
  @@index([projectId, status, createdAt])
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  description     String
  specification   String?
  quantity        Decimal       @db.Decimal(14, 3)
  receivedQty     Decimal       @default(0) @db.Decimal(14, 3)
  unit            String
  unitRate        Decimal       @db.Decimal(14, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  @@index([purchaseOrderId])
}

model MaterialReceipt {
  id              String        @id @default(uuid())
  purchaseOrderId String
  receiptNumber   String
  receivedAt      DateTime      @default(now())
  receivedBy      String
  evidenceUrl     String?
  notes           String?
  lines           Json
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  @@unique([purchaseOrderId, receiptNumber])
  @@index([purchaseOrderId, receivedAt])
}

model LabourRecord {
  id             String            @id @default(uuid())
  projectId      String
  workerName     String
  workDate       DateTime
  workType       String
  description    String
  quantity       Decimal           @db.Decimal(14, 3)
  unit           String
  rate           Decimal           @db.Decimal(14, 2)
  amount         Decimal           @db.Decimal(14, 2)
  status         LabourRecordStatus @default(SUBMITTED)
  recordedById   String
  approvedById   String?
  evidenceUrl    String?
  createdAt      DateTime          @default(now())
  approvedAt     DateTime?
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedBy     User              @relation("LabourRecorder", fields: [recordedById], references: [id])
  @@index([projectId, workDate, status])
}

enum ProjectUpdateCategory {
  SITE_PROGRESS
  MATERIAL_DELIVERY
  QUALITY
  SAFETY
  MILESTONE
  GENERAL
}

model ProjectUpdate {
  id          String                @id @default(uuid())
  projectId   String
  category    ProjectUpdateCategory @default(GENERAL)
  title       String
  description String
  latitude    Decimal?              @db.Decimal(10, 7)
  longitude   Decimal?              @db.Decimal(10, 7)
  recordedAt  DateTime              @default(now())
  createdById String
  customerVisible Boolean           @default(false)
  createdAt   DateTime              @default(now())
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation("ProjectUpdateAuthor", fields: [createdById], references: [id])
  documents   ProjectDocument[]
  @@index([projectId, recordedAt])
  @@index([createdById, recordedAt])
}

enum ProjectDocumentStatus {
  PENDING_UPLOAD
  AVAILABLE
  REJECTED
}

enum ProjectDocumentCategory {
  DRAWING
  APPROVAL
  INVOICE
  PAYMENT_PROOF
  MATERIAL_RECEIPT
  LABOUR_EVIDENCE
  SITE_PHOTO
  AGREEMENT
  OTHER
}

model ProjectDocument {
  id              String                  @id @default(uuid())
  projectId       String
  uploadedById    String
  category        ProjectDocumentCategory @default(OTHER)
  status          ProjectDocumentStatus   @default(PENDING_UPLOAD)
  originalName    String
  storageKey      String                  @unique
  contentType     String
  sizeBytes       Int
  customerVisible Boolean                 @default(false)
  description     String?
  createdAt       DateTime                @default(now())
  availableAt     DateTime?
  projectUpdateId String?
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectUpdate   ProjectUpdate?          @relation(fields: [projectUpdateId], references: [id], onDelete: SetNull)
  uploadedBy      User                    @relation("ProjectDocumentUploader", fields: [uploadedById], references: [id])
  @@index([projectId, status, category, createdAt])
  @@index([uploadedById, status])
  @@index([projectUpdateId, status])
}

enum TopUpRequestStatus {
  SUBMITTED
  CONFIRMED
  REJECTED
}

model TopUpRequest {
  id             String             @id @default(uuid())
  projectId      String
  requestedById  String
  reviewedById   String?
  amount         Decimal            @db.Decimal(14, 2)
  paymentMode    String
  reference      String
  notes          String?
  status         TopUpRequestStatus @default(SUBMITTED)
  reviewReason   String?
  ledgerEntryId  String?            @unique
  submittedAt    DateTime           @default(now())
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy    User               @relation("TopUpRequester", fields: [requestedById], references: [id])
  reviewedBy     User?              @relation("TopUpReviewer", fields: [reviewedById], references: [id])
  ledgerEntry    LedgerEntry?       @relation(fields: [ledgerEntryId], references: [id])
  @@unique([projectId, reference])
  @@index([projectId, status, submittedAt])
  @@index([requestedById, status])
}

enum ProjectMilestoneStatus {
  PLANNED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum ProjectTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ProjectMilestone {
  id              String                 @id @default(uuid())
  projectId       String
  title           String
  description     String?
  status          ProjectMilestoneStatus @default(PLANNED)
  targetDate      DateTime?
  forecastDate    DateTime?
  completedAt     DateTime?
  sequence        Int                    @default(0)
  customerVisible Boolean                @default(true)
  createdById     String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  project         Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks           ProjectTask[]
  @@index([projectId, sequence, status])
}

model ProjectTask {
  id              String             @id @default(uuid())
  projectId       String
  milestoneId     String?
  title           String
  description     String?
  workPackage     String?
  status          ProjectTaskStatus  @default(TODO)
  priority        ProjectTaskPriority @default(MEDIUM)
  progressPercent Int                @default(0)
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  blockedReason   String?
  customerVisible Boolean            @default(false)
  assignedToId    String?
  createdById     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone       ProjectMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignedTo      User?              @relation("ProjectTaskAssignee", fields: [assignedToId], references: [id])
  createdBy       User               @relation("ProjectTaskCreator", fields: [createdById], references: [id])
  blocks          TaskDependency[]   @relation("TaskPredecessor")
  blockedBy       TaskDependency[]   @relation("TaskSuccessor")
  @@index([projectId, status, dueDate])
  @@index([assignedToId, status, dueDate])
  @@index([milestoneId, status])
}

model TaskDependency {
  id            String      @id @default(uuid())
  predecessorId String
  successorId   String
  createdAt     DateTime    @default(now())
  predecessor   ProjectTask @relation("TaskPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     ProjectTask @relation("TaskSuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  @@unique([predecessorId, successorId])
  @@index([successorId])
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TOP_UP_CONFIRMED
  TOP_UP_REJECTED
  EXPENSE_APPROVED
  EXPENSE_POSTED
  LABOUR_APPROVED
  PURCHASE_ORDER_APPROVED
  SITE_UPDATE_PUBLISHED
  GENERAL
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  actorId     String?
  projectId   String?
  type        NotificationType @default(GENERAL)
  title       String
  message     String
  entityType  String?
  entityId    String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([recipientId, readAt, createdAt])
  @@index([projectId, createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  PROPOSAL
  CONVERTED
  LOST
}

model Lead {
  id           String     @id @default(uuid())
  name         String
  email        String?
  phone        String
  interest     String
  message      String?
  source       String     @default("WEBSITE")
  status       LeadStatus @default(NEW)
  assignedToId String?
  internalNotes String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignedTo   User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([assignedToId, status, createdAt])
}

model CustomerInvitation {
  id          String   @id @default(uuid())
  userId      String
  invitedById String
  email       String
  tokenHash   String   @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User     @relation("InvitationInviter", fields: [invitedById], references: [id])
  @@index([userId, expiresAt])
  @@index([invitedById, createdAt])
}
